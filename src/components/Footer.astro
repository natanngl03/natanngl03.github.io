---
import { Icon } from "astro-icon/components";
---

<div class="container-fluid copyright text-light wow fadeIn" data-wow-delay="0.1s" id="footer">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="row">
                    <div class="col-lg-8">
                        <p class="h3 text-white">EROSOFT.ID</p>
                        <p>Kami membantu bisnis dan UMKM membangun website profesional yang modern, cepat, dan responsif.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <h5 class="text-white mb-4">Kantor Kami</h5>
                <p class="mb-2 d-flex align-items-center gap-2">
                    <Icon name="fa6-solid:location-dot" />
                    <span>Jl. Perum Griya Asri Raya No.10 Blok B3</span>
                </p>
                <p class="mb-2 d-flex align-items-center gap-2">
                    <Icon name="fa6-solid:phone" />
                    <span>085117436727</span>
                </p>
                <p class="mb-2 d-flex align-items-center gap-2">
                    <Icon name="fa6-solid:envelope" />
                    <span>contact@erosoft.id</span>
                </p>
            </div>

            <div class="col-lg-2">
                <h5 class="mb-4">Operasional</h5>
                <p class="mb-1">Senin - Jumat</p>
                <h6 class="">09:00 - 20:00</h6>
                <p class="mb-1">Sabtu</p>
                <h6 class="">09:00 - 17:00</h6>
                <p class="mb-1">Minggu & Tanggal Merah</p>
                <h6 class="">Tutup</h6>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-4 copyright wow fadeIn" data-wow-delay="0.1s">
    <div class="container" id="trademark">
        <div class="row">
            <div class="text-center">
                &copy; <a class="border-bottom" href="/">EROSOFT.ID</a> - All Right Reserved.
            </div>
        </div>
    </div>
</div>
