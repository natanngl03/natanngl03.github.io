---
import { Image } from "astro:assets";

import HeroImage from "./../assets/img/hero.webp";
---

<div class="hero-container" id="Hero">
    <div class="container hero-content">
        <div class="row">
            <div class="col-md-8">
                <h1 class:list={["display-4 h1 mb-4 text-dark text-shadow", "wow fadeInDown"]} data-wow-delay="0.2s">
                    Website Profesional untuk Bisnis Anda
                </h1>
                <span class="btn btn-primary py-2 px-4 wow fadeInDown" data-wow-delay="0.3s" id="penawaran">Lihat Penawaran</span>
            </div>
        </div>
    </div>

    <Image
        src={HeroImage}
        alt="hero image"
        layout="constrained"
        class="hero-img wow fadeIn"
        data-wow-delay="0.1s"
        width={1920}
        height={1080}
        quality={70}
    />
</div>

<script>
    const navbar = document.querySelector<HTMLElement>("#navbar-container");
    if (navbar) {
        const navbarHeight = navbar.offsetHeight;

        const heroContainer = document.querySelector<HTMLElement>("div.hero-container");
        if (heroContainer) {
            heroContainer.style.paddingTop = `${navbarHeight}px`;
        }
    }

    const lihatPenawaran = document.getElementById("penawaran");
    if (lihatPenawaran) {
        lihatPenawaran.addEventListener("click", () => {
            const sectionPrice = document.getElementById("SectionPrice");
            if (sectionPrice) {
                sectionPrice.scrollIntoView({
                    behavior: "smooth",
                    block: "start",
                });
            }
        });
    }
</script>

<style>
    .hero-container {
        height: 100vh;
        position: relative;
    }

    .hero-content {
        height: 100%;
        display: flex;
        align-items: center;
    }

    .hero-img {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
        object-fit: cover;
        object-position: top;
    }
    .text-shadow {
        text-shadow: 0 2px 2px rgba(255, 255, 255, 255.5);
    }
</style>
