---
import FaqItem from "./Faq.Accordion.astro";

type FaqType = {
    question: string;
    answer: string;
};

const Questions: Array<FaqType> = [
    {
        question: "Berapa lama proses pembuatan website?",
        answer: "Waktu pengerjaan bergantung pada kompleksitas proyek. Umumnya website sederhana dapat diselesaikan dalam 3-7 hari kerja.",
    },
    {
        question: "Apakah website sudah ramah SEO?",
        answer: "Ya, website dikembangkan dengan struktur yang ramah SEO untuk membantu meningkatkan visibilitas di mesin pencari.",
    },
    {
        question: "Apakah saya mendapatkan domain dan hosting?",
        answer: "Ya, domain dan hosting dapat disertakan sesuai paket yang dipilih atau menggunakan layanan yang sudah Anda miliki.",
    },
    {
        question: "Apakah website dapat dikelola sendiri?",
        answer: "Tentu. Untuk paket yang menyertakan dashboard admin, Anda dapat mengelola konten website secara mandiri.",
    },
    {
        question: "Apakah tersedia revisi desain?",
        answer: "Ya, kami menyediakan revisi sesuai ketentuan yang berlaku pada paket yang dipilih.",
    },
    {
        question: "Bagaimana proses pemesanan dan pembayaran?",
        answer: "Pemesanan dimulai dengan konsultasi kebutuhan, dilanjutkan dengan penawaran harga, pembayaran uang muka, dan proses pengerjaan.",
    },
    {
        question: "Apakah tersedia dukungan setelah website selesai dibuat?",
        answer: "Ya, kami menyediakan dukungan teknis untuk membantu memastikan website berjalan dengan baik setelah peluncuran.",
    },
    {
        question: "Bisakah website dikembangkan di kemudian hari?",
        answer: "Tentu. Website dapat ditambahkan fitur atau dikembangkan lebih lanjut sesuai kebutuhan bisnis Anda di masa mendatang.",
    },
];
---

<!-- FAQs Start -->
<section class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s" id="SectionFaq">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="section-title-1 position-relative pb-3 mb-5">
                    <h6 class="fw-bold text-primary text-uppercase">FAQs</h6>
                    <h2 class="mb-0">Pertanyaan yang Sering Diajukan</h2>
                </div>
                <p class="mb-4">
                    Kami telah merangkum beberapa pertanyaan yang paling sering ditanyakan oleh calon klien untuk membantu Anda memahami
                    layanan, fitur, dan proses kerja kami dengan lebih jelas.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="accordion accordion-custom" id="accordionExample">
                    {
                        Questions.map((val, idx) => {
                            const { question, answer } = val;
                            return <FaqItem question={question} answer={answer} idx={idx} />;
                        })
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- FAQs End -->
